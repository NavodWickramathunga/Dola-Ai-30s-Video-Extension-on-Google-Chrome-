{
  "manifest_version": 3,
  "name": "Dola AI 30s Video Maker",
  "short_name": "Dola 30s Video",
  "version": "2.0.0",
  "description": "Paste your prompt in Dola AI as usual. Get one single 30-second Seedance 2.5 video, downloaded automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dola AI 30s Video Maker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://*.dola.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dola.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dola.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
